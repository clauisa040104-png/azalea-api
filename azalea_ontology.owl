<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.azalearcare.com/ontology#"
     xml:base="http://www.azalearcare.com/ontology"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">

    <!-- ============================================================ -->
    <!--  ONTOLOGÍA AZALEARCARE                                        -->
    <!--  Proyecto: AzaleaCare - Sistema experto para cuidado         -->
    <!--  de azaleas y diagnóstico de enfermedades                    -->
    <!--  Autora: Chabelita - UDABOL, Cochabamba, Bolivia             -->
    <!-- ============================================================ -->

    <owl:Ontology rdf:about="http://www.azalearcare.com/ontology">
        <dc:title>Ontología AzaleaCare</dc:title>
        <dc:description>Ontología formal para el sistema experto de diagnóstico y cuidado de azaleas</dc:description>
        <dc:creator>AzaleaCare - UDABOL</dc:creator>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!--  CLASES PRINCIPALES                                           -->
    <!-- ============================================================ -->

    <owl:Class rdf:about="#Planta">
        <rdfs:label xml:lang="es">Planta</rdfs:label>
        <rdfs:comment>Clase base para todas las plantas</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Azalea">
        <rdfs:subClassOf rdf:resource="#Planta"/>
        <rdfs:label xml:lang="es">Azalea</rdfs:label>
        <rdfs:comment>Planta ornamental del género Rhododendron, foco principal del sistema</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Enfermedad">
        <rdfs:label xml:lang="es">Enfermedad</rdfs:label>
        <rdfs:comment>Condición patológica que afecta a la azalea</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Sintoma">
        <rdfs:label xml:lang="es">Síntoma</rdfs:label>
        <rdfs:comment>Manifestación visible de una enfermedad en la planta</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Tratamiento">
        <rdfs:label xml:lang="es">Tratamiento</rdfs:label>
        <rdfs:comment>Acción recomendada para tratar o prevenir una enfermedad</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Severidad">
        <rdfs:label xml:lang="es">Severidad</rdfs:label>
        <rdfs:comment>Nivel de gravedad de una enfermedad</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#CuidadoGeneral">
        <rdfs:label xml:lang="es">Cuidado General</rdfs:label>
        <rdfs:comment>Conjunto de prácticas para el cuidado óptimo de la azalea</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Riego">
        <rdfs:subClassOf rdf:resource="#CuidadoGeneral"/>
        <rdfs:label xml:lang="es">Riego</rdfs:label>
        <rdfs:comment>Práctica de suministro de agua a la azalea</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Iluminacion">
        <rdfs:subClassOf rdf:resource="#CuidadoGeneral"/>
        <rdfs:label xml:lang="es">Iluminación</rdfs:label>
        <rdfs:comment>Requisitos de luz solar para la azalea</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Temperatura">
        <rdfs:subClassOf rdf:resource="#CuidadoGeneral"/>
        <rdfs:label xml:lang="es">Temperatura</rdfs:label>
        <rdfs:comment>Rango de temperatura óptimo para la azalea</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Abono">
        <rdfs:subClassOf rdf:resource="#CuidadoGeneral"/>
        <rdfs:label xml:lang="es">Abono y Nutrientes</rdfs:label>
        <rdfs:comment>Fertilización y nutrición de la azalea</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Poda">
        <rdfs:subClassOf rdf:resource="#CuidadoGeneral"/>
        <rdfs:label xml:lang="es">Poda</rdfs:label>
        <rdfs:comment>Práctica de recorte y mantenimiento de la azalea</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Compatibilidad">
        <rdfs:label xml:lang="es">Compatibilidad con otras plantas</rdfs:label>
        <rdfs:comment>Relación de convivencia entre la azalea y otras especies</rdfs:comment>
    </owl:Class>

    <!-- ============================================================ -->
    <!--  SUBCLASES DE SEVERIDAD                                       -->
    <!-- ============================================================ -->

    <owl:Class rdf:about="#SeveridadLeve">
        <rdfs:subClassOf rdf:resource="#Severidad"/>
        <rdfs:label xml:lang="es">Leve</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#SeveridadModerada">
        <rdfs:subClassOf rdf:resource="#Severidad"/>
        <rdfs:label xml:lang="es">Moderada</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#SeveridadGrave">
        <rdfs:subClassOf rdf:resource="#Severidad"/>
        <rdfs:label xml:lang="es">Grave</rdfs:label>
    </owl:Class>

    <!-- ============================================================ -->
    <!--  PROPIEDADES DE OBJETO (Object Properties)                   -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="#tieneSintoma">
        <rdfs:domain rdf:resource="#Enfermedad"/>
        <rdfs:range rdf:resource="#Sintoma"/>
        <rdfs:label xml:lang="es">tiene síntoma</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#tieneTratamiento">
        <rdfs:domain rdf:resource="#Enfermedad"/>
        <rdfs:range rdf:resource="#Tratamiento"/>
        <rdfs:label xml:lang="es">tiene tratamiento</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#tieneSeveridad">
        <rdfs:domain rdf:resource="#Enfermedad"/>
        <rdfs:range rdf:resource="#Severidad"/>
        <rdfs:label xml:lang="es">tiene severidad</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#afectaA">
        <rdfs:domain rdf:resource="#Enfermedad"/>
        <rdfs:range rdf:resource="#Azalea"/>
        <rdfs:label xml:lang="es">afecta a</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#requiereCuidado">
        <rdfs:domain rdf:resource="#Azalea"/>
        <rdfs:range rdf:resource="#CuidadoGeneral"/>
        <rdfs:label xml:lang="es">requiere cuidado</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#esCompatibleCon">
        <rdfs:domain rdf:resource="#Azalea"/>
        <rdfs:range rdf:resource="#Planta"/>
        <rdfs:label xml:lang="es">es compatible con</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#noEsCompatibleCon">
        <rdfs:domain rdf:resource="#Azalea"/>
        <rdfs:range rdf:resource="#Planta"/>
        <rdfs:label xml:lang="es">no es compatible con</rdfs:label>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!--  PROPIEDADES DE DATOS (Data Properties)                      -->
    <!-- ============================================================ -->

    <owl:DatatypeProperty rdf:about="#nombreComun">
        <rdfs:label xml:lang="es">nombre común</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#descripcion">
        <rdfs:label xml:lang="es">descripción</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#frecuenciaRiego">
        <rdfs:domain rdf:resource="#Riego"/>
        <rdfs:label xml:lang="es">frecuencia de riego</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#cantidadAgua">
        <rdfs:domain rdf:resource="#Riego"/>
        <rdfs:label xml:lang="es">cantidad de agua</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#horasLuz">
        <rdfs:domain rdf:resource="#Iluminacion"/>
        <rdfs:label xml:lang="es">horas de luz recomendadas</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tipoLuz">
        <rdfs:domain rdf:resource="#Iluminacion"/>
        <rdfs:label xml:lang="es">tipo de luz</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#temperaturaMinima">
        <rdfs:domain rdf:resource="#Temperatura"/>
        <rdfs:label xml:lang="es">temperatura mínima (°C)</rdfs:label>
        <rdfs:range rdf:resource="xsd:integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#temperaturaMaxima">
        <rdfs:domain rdf:resource="#Temperatura"/>
        <rdfs:label xml:lang="es">temperatura máxima (°C)</rdfs:label>
        <rdfs:range rdf:resource="xsd:integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#temperaturaOptima">
        <rdfs:domain rdf:resource="#Temperatura"/>
        <rdfs:label xml:lang="es">temperatura óptima (°C)</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tipoAbono">
        <rdfs:domain rdf:resource="#Abono"/>
        <rdfs:label xml:lang="es">tipo de abono recomendado</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#frecuenciaAbono">
        <rdfs:domain rdf:resource="#Abono"/>
        <rdfs:label xml:lang="es">frecuencia de abonado</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#epocaAbono">
        <rdfs:domain rdf:resource="#Abono"/>
        <rdfs:label xml:lang="es">época de abonado</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#epocaPoda">
        <rdfs:domain rdf:resource="#Poda"/>
        <rdfs:label xml:lang="es">época de poda</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tipoPoda">
        <rdfs:domain rdf:resource="#Poda"/>
        <rdfs:label xml:lang="es">tipo de poda</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#agenteCausal">
        <rdfs:domain rdf:resource="#Enfermedad"/>
        <rdfs:label xml:lang="es">agente causal</rdfs:label>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#confianzaDiagnostico">
        <rdfs:domain rdf:resource="#Enfermedad"/>
        <rdfs:label xml:lang="es">confianza de diagnóstico (%)</rdfs:label>
        <rdfs:range rdf:resource="xsd:float"/>
    </owl:DatatypeProperty>

    <!-- ============================================================ -->
    <!--  INDIVIDUOS - ENFERMEDADES                                    -->
    <!-- ============================================================ -->

    <!-- OIDIO -->
    <owl:NamedIndividual rdf:about="#Oidio">
        <rdf:type rdf:resource="#Enfermedad"/>
        <nombreComun>Oidio / Moho Blanco</nombreComun>
        <descripcion>Enfermedad fúngica causada por hongos del orden Erysiphales. Produce una capa blanca pulverulenta sobre hojas y tallos. Es muy común en condiciones de alta humedad y temperaturas moderadas.</descripcion>
        <agenteCausal>Erysiphe spp. (hongo)</agenteCausal>
        <tieneSeveridad rdf:resource="#SeveridadLeve"/>
        <tieneSeveridad rdf:resource="#SeveridadModerada"/>
        <tieneSeveridad rdf:resource="#SeveridadGrave"/>
        <tieneSintoma rdf:resource="#SintomaPolvoBlanco"/>
        <tieneSintoma rdf:resource="#SintomaHojasDeformadas"/>
        <tieneSintoma rdf:resource="#SintomaAmarillamiento"/>
        <tieneTratamiento rdf:resource="#TratamientoFungicidaAzufre"/>
        <tieneTratamiento rdf:resource="#TratamientoVentilacion"/>
        <tieneTratamiento rdf:resource="#TratamientoEliminarHojasAfectadas"/>
    </owl:NamedIndividual>

    <!-- MANCHA FOLIAR -->
    <owl:NamedIndividual rdf:about="#ManchaFoliar">
        <rdf:type rdf:resource="#Enfermedad"/>
        <nombreComun>Mancha Foliar</nombreComun>
        <descripcion>Lesiones necróticas de color marrón, negro o amarillo sobre las hojas. Puede ser causada por hongos o bacterias. Se propaga por salpicaduras de agua y herramientas contaminadas.</descripcion>
        <agenteCausal>Cercospora spp., Pestalotiopsis spp. (hongos) o Pseudomonas spp. (bacteria)</agenteCausal>
        <tieneSeveridad rdf:resource="#SeveridadLeve"/>
        <tieneSeveridad rdf:resource="#SeveridadModerada"/>
        <tieneSeveridad rdf:resource="#SeveridadGrave"/>
        <tieneSintoma rdf:resource="#SintomaManchasMarrones"/>
        <tieneSintoma rdf:resource="#SintomaManchasAmarillas"/>
        <tieneSintoma rdf:resource="#SintomaCaidaHojas"/>
        <tieneTratamiento rdf:resource="#TratamientoFungicidaCobre"/>
        <tieneTratamiento rdf:resource="#TratamientoEliminarHojasAfectadas"/>
        <tieneTratamiento rdf:resource="#TratamientoMejorarDrenaje"/>
    </owl:NamedIndividual>

    <!-- ROYA EN HOJA -->
    <owl:NamedIndividual rdf:about="#RoyaEnHoja">
        <rdf:type rdf:resource="#Enfermedad"/>
        <nombreComun>Roya / Roya de la Hoja</nombreComun>
        <descripcion>Enfermedad fúngica caracterizada por pústulas de color naranja-rojizo en el envés de las hojas. Debilita la planta progresivamente y reduce la capacidad fotosintética.</descripcion>
        <agenteCausal>Phragmidium spp. o Puccinia spp. (hongos basidiomicetos)</agenteCausal>
        <tieneSeveridad rdf:resource="#SeveridadLeve"/>
        <tieneSeveridad rdf:resource="#SeveridadModerada"/>
        <tieneSeveridad rdf:resource="#SeveridadGrave"/>
        <tieneSintoma rdf:resource="#SintomaPustulaAnaranjada"/>
        <tieneSintoma rdf:resource="#SintomaAmarillamiento"/>
        <tieneSintoma rdf:resource="#SintomaCaidaHojas"/>
        <tieneTratamiento rdf:resource="#TratamientoFungicidaSistemica"/>
        <tieneTratamiento rdf:resource="#TratamientoEliminarHojasAfectadas"/>
        <tieneTratamiento rdf:resource="#TratamientoEvitarMojado"/>
    </owl:NamedIndividual>

    <!-- PHYTOPHTHORA -->
    <owl:NamedIndividual rdf:about="#Phytophthora">
        <rdf:type rdf:resource="#Enfermedad"/>
        <nombreComun>Phytophthora / Pudrición de Raíz</nombreComun>
        <descripcion>Enfermedad causada por oomicetos (pseudohongos). Provoca pudrición de raíces y cuello de la planta. Es una de las enfermedades más destructivas para las azaleas, especialmente en suelos con mal drenaje.</descripcion>
        <agenteCausal>Phytophthora cinnamomi (oomiceto)</agenteCausal>
        <tieneSeveridad rdf:resource="#SeveridadModerada"/>
        <tieneSeveridad rdf:resource="#SeveridadGrave"/>
        <tieneSintoma rdf:resource="#SintomaPudricionRaiz"/>
        <tieneSintoma rdf:resource="#SintomaMarchitamiento"/>
        <tieneSintoma rdf:resource="#SintomaTalloNegro"/>
        <tieneSintoma rdf:resource="#SintomaAmarillamiento"/>
        <tieneTratamiento rdf:resource="#TratamientoFosetilAluminio"/>
        <tieneTratamiento rdf:resource="#TratamientoMejorarDrenaje"/>
        <tieneTratamiento rdf:resource="#TratamientoReplantar"/>
    </owl:NamedIndividual>

    <!-- BOTRYTIS -->
    <owl:NamedIndividual rdf:about="#Botrytis">
        <rdf:type rdf:resource="#Enfermedad"/>
        <nombreComun>Botrytis / Moho Gris</nombreComun>
        <descripcion>Enfermedad fúngica que produce un moho gris característico sobre flores, hojas y tallos. Se desarrolla en condiciones de alta humedad y temperaturas frescas. Muy común en épocas lluviosas.</descripcion>
        <agenteCausal>Botrytis cinerea (hongo)</agenteCausal>
        <tieneSeveridad rdf:resource="#SeveridadLeve"/>
        <tieneSeveridad rdf:resource="#SeveridadModerada"/>
        <tieneSeveridad rdf:resource="#SeveridadGrave"/>
        <tieneSintoma rdf:resource="#SintomaMohoGris"/>
        <tieneSintoma rdf:resource="#SintomaPudricioFlores"/>
        <tieneSintoma rdf:resource="#SintomaManchasMarrones"/>
        <tieneTratamiento rdf:resource="#TratamientoFungicidaBotrytis"/>
        <tieneTratamiento rdf:resource="#TratamientoVentilacion"/>
        <tieneTratamiento rdf:resource="#TratamientoEliminarPartesAfectadas"/>
    </owl:NamedIndividual>

<!-- DEFICIENCIA DE MAGNESIO -->
<owl:NamedIndividual rdf:about="#DeficienciaMagnesio">
    <rdf:type rdf:resource="#Enfermedad"/>
    <nombreComun>Deficiencia de Magnesio</nombreComun>
    <descripcion>Trastorno nutricional (no infeccioso) causado por falta de magnesio disponible en el sustrato, frecuentemente agravado por un pH fuera del rango ácido óptimo. Provoca clorosis internerval, sobre todo en hojas más viejas.</descripcion>
    <agenteCausal>Deficiencia nutricional (falta de magnesio en el sustrato, agravada por pH inadecuado)</agenteCausal>
    <tieneSeveridad rdf:resource="#SeveridadLeve"/>
    <tieneSeveridad rdf:resource="#SeveridadModerada"/>
    <tieneSintoma rdf:resource="#SintomaAmarillamiento"/>
    <tieneSintoma rdf:resource="#SintomaClorosisInternervalHojasNuevas"/>
    <tieneTratamiento rdf:resource="#TratamientoAbonoMagnesio"/>
    <tieneTratamiento rdf:resource="#TratamientoMejorarDrenaje"/>
</owl:NamedIndividual>

    <!-- SANA -->
    <owl:NamedIndividual rdf:about="#PlantaSana">
        <rdf:type rdf:resource="#Enfermedad"/>
        <nombreComun>Planta Sana</nombreComun>
        <descripcion>La azalea no presenta signos de enfermedad. Se recomienda mantener las buenas prácticas de cuidado para prevenir futuras enfermedades.</descripcion>
        <agenteCausal>Ninguno</agenteCausal>
        <tieneTratamiento rdf:resource="#TratamientoPreventivo"/>
    </owl:NamedIndividual>

    <!-- NO AZALEA -->
    <owl:NamedIndividual rdf:about="#NoAzalea">
        <rdf:type rdf:resource="#Enfermedad"/>
        <nombreComun>No es una Azalea</nombreComun>
        <descripcion>La imagen analizada no corresponde a una planta azalea. El sistema solo está entrenado para diagnosticar azaleas.</descripcion>
        <agenteCausal>No aplica</agenteCausal>
    </owl:NamedIndividual>

    <!-- ============================================================ -->
    <!--  INDIVIDUOS - SÍNTOMAS                                        -->
    <!-- ============================================================ -->

    <owl:NamedIndividual rdf:about="#SintomaPolvoBlanco">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Capa blanca pulverulenta sobre la superficie de hojas y tallos, característica del oidio</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaHojasDeformadas">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Hojas con forma anormal, arrugadas o enroscadas debido a la infección fúngica</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaAmarillamiento">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Coloración amarilla de las hojas (clorosis), indicativo de daño celular o deficiencia</descripcion>
    </owl:NamedIndividual>

     <owl:NamedIndividual rdf:about="#SintomaClorosisInternervalHojasNuevas">
    <rdf:type rdf:resource="#Sintoma"/>
    <descripcion>Amarilleo marcado entre las venas de las hojas nuevas, con la vena principal aún verde; se intensifica en suelos con pH fuera del rango 4.5-6.0</descripcion>
</owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaManchasMarrones">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Manchas necróticas de color marrón o negro sobre la superficie foliar</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaManchasAmarillas">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Manchas de coloración amarilla sobre las hojas, borde irregular</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaCaidaHojas">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Defoliación prematura de la planta antes de la época normal</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaPustulaAnaranjada">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Pústulas de color naranja-rojizo en el envés de las hojas, características de la roya</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaPudricionRaiz">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Raíces de color marrón-negro, blandas y putrefactas al tacto</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaMarchitamiento">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Planta con aspecto decaído, hojas sin turgencia a pesar de riego adecuado</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaTalloNegro">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Oscurecimiento del tallo a nivel del cuello de la planta, señal de pudrición</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaMohoGris">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Masa algodonosa de color gris sobre flores, hojas o tallos, característica de Botrytis</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#SintomaPudricioFlores">
        <rdf:type rdf:resource="#Sintoma"/>
        <descripcion>Flores blandas, decoloradas y cubiertas de esporas grises</descripcion>
    </owl:NamedIndividual>

    <!-- ============================================================ -->
    <!--  INDIVIDUOS - TRATAMIENTOS                                    -->
    <!-- ============================================================ -->

    <owl:NamedIndividual rdf:about="#TratamientoFungicidaAzufre">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Aplicar fungicida a base de azufre o bicarbonato de potasio. Repetir cada 7-10 días hasta controlar la infección. Aplicar en horas frescas del día.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoVentilacion">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Mejorar la circulación de aire alrededor de la planta. Separar plantas muy juntas. Evitar riego por aspersión. Podar ramas internas para airear la copa.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoEliminarHojasAfectadas">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Retirar y destruir (no compostar) todas las hojas infectadas. Desinfectar las herramientas de poda con alcohol al 70% antes y después de cada uso.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoFungicidaCobre">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Aplicar fungicida cúprico (oxicloruro de cobre) en pulverización foliar. Tratar cada 10-14 días. Evitar aplicar en horas de sol intenso para prevenir fitotoxicidad.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoMejorarDrenaje">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Asegurar que el sustrato tenga buen drenaje. Añadir perlita o arena gruesa al sustrato. Usar macetas con agujeros de drenaje. Evitar el encharcamiento.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoFungicidaSistemica">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Aplicar fungicida sistémico (tebuconazol o miclobutanil). Este tipo penetra en los tejidos de la planta y erradica la infección desde adentro. Seguir indicaciones del fabricante.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoEvitarMojado">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Evitar mojar el follaje al regar. Regar directamente en la base de la planta. No regar por la tarde o noche. Mantener las hojas secas para prevenir esporas.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoFosetilAluminio">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Aplicar fosetil-aluminio o metalaxil al suelo para combatir oomicetos. Tratamiento urgente necesario. En casos graves considerar trasplante a sustrato estéril nuevo.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoReplantar">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Si la infección es severa, extraer la planta, limpiar las raíces sanas, aplicar fungicida en raíces y replantar en sustrato nuevo y bien drenado. Desechar el sustrato contaminado.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoFungicidaBotrytis">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Aplicar fungicida específico para Botrytis (iprodiona, fenhexamida o pirimetanil). Alternar principios activos para evitar resistencias. Tratar cada 7 días en condiciones húmedas.</descripcion>
    </owl:NamedIndividual>

     <owl:NamedIndividual rdf:about="#TratamientoAbonoMagnesio">
    <rdf:type rdf:resource="#Tratamiento"/>
    <descripcion>Aplicar fertilizante rico en magnesio (sulfato de magnesio disuelto en agua de riego, tipo sal de Epsom) cada 4-6 semanas. Verificar que el pH del sustrato esté entre 4.5-6.0, ya que un pH alcalino bloquea la absorción de magnesio aunque esté presente en el suelo.</descripcion>
</owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoEliminarPartesAfectadas">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Retirar flores, hojas y tallos afectados inmediatamente. Bolsa y desechar (no compostar). Limpiar área alrededor de la planta de restos vegetales caídos.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#TratamientoPreventivo">
        <rdf:type rdf:resource="#Tratamiento"/>
        <descripcion>Mantener buenas prácticas de cuidado: riego adecuado, buena ventilación, abonado en época correcta, revisión periódica de hojas y tallos. Aplicar fungicida preventivo al inicio de épocas lluviosas.</descripcion>
    </owl:NamedIndividual>

    <!-- ============================================================ -->
    <!--  INDIVIDUOS - CUIDADO GENERAL                                 -->
    <!-- ============================================================ -->

    <!-- RIEGO -->
    <owl:NamedIndividual rdf:about="#RiegoAzalea">
        <rdf:type rdf:resource="#Riego"/>
        <frecuenciaRiego>Cada 2-3 días en verano, cada 5-7 días en invierno. En primavera y otoño, cada 3-4 días según condiciones.</frecuenciaRiego>
        <cantidadAgua>Regar abundantemente hasta que el agua drene por los agujeros. Luego esperar que los primeros 2-3 cm de sustrato estén secos antes de volver a regar.</cantidadAgua>
        <descripcion>Las azaleas requieren riego regular pero sin encharcamiento. Prefieren agua sin cloro o lluvia. Son muy sensibles tanto a la sequía como al exceso de agua. Usar agua a temperatura ambiente.</descripcion>
    </owl:NamedIndividual>

    <!-- ILUMINACIÓN -->
    <owl:NamedIndividual rdf:about="#IluminacionAzalea">
        <rdf:type rdf:resource="#Iluminacion"/>
        <horasLuz>4-6 horas de luz indirecta o filtrada por día</horasLuz>
        <tipoLuz>Luz indirecta brillante. Evitar sol directo del mediodía. Funcionan bien bajo árboles caducifolios o en orientación este/norte.</tipoLuz>
        <descripcion>Las azaleas prefieren sombra parcial. El sol directo intenso quema las hojas y estresa la planta. En interiores, colocar cerca de ventanas con luz filtrada. Pueden tolerar más sol en climas frescos.</descripcion>
    </owl:NamedIndividual>

    <!-- TEMPERATURA -->
    <owl:NamedIndividual rdf:about="#TemperaturaAzalea">
        <rdf:type rdf:resource="#Temperatura"/>
        <temperaturaMinima>5</temperaturaMinima>
        <temperaturaMaxima>25</temperaturaMaxima>
        <temperaturaOptima>15-21°C durante el día, ligeramente más fresco por la noche</temperaturaOptima>
        <descripcion>Las azaleas son plantas de clima templado-fresco. No toleran heladas prolongadas ni calor extremo. Las temperaturas frescas de otoño-invierno son necesarias para estimular la floración. Evitar corrientes de aire frío directo.</descripcion>
    </owl:NamedIndividual>

    <!-- ABONO -->
    <owl:NamedIndividual rdf:about="#AbonoAzalea">
        <rdf:type rdf:resource="#Abono"/>
        <tipoAbono>Fertilizante específico para plantas acidófilas (azaleas, rododendros, camelias) rico en hierro y magnesio. pH del sustrato ideal: 4.5-6.0</tipoAbono>
        <frecuenciaAbono>Cada 15-30 días durante primavera y verano (época de crecimiento activo)</frecuenciaAbono>
        <epocaAbono>Primavera y verano. Suspender abonado en otoño e invierno para que la planta descanse. Retomar en marzo-abril.</epocaAbono>
        <descripcion>Las azaleas son acidófilas y requieren sustratos y fertilizantes con pH bajo. El abono genérico puede dañarlas. No abonar durante la floración para no acortarla. Nunca abonar una planta estresada por sequía o enfermedad.</descripcion>
    </owl:NamedIndividual>

    <!-- PODA -->
    <owl:NamedIndividual rdf:about="#PodaAzalea">
        <rdf:type rdf:resource="#Poda"/>
        <epocaPoda>Inmediatamente después de la floración (generalmente primavera). Nunca podar en otoño o invierno ya que se eliminan los brotes florales.</epocaPoda>
        <tipoPoda>Poda de mantenimiento: eliminar ramas secas, dañadas o cruzadas. Poda de formación: dar forma al arbusto. Poda de rejuvenecimiento: corte drástico para plantas muy viejas o descuidadas.</tipoPoda>
        <descripcion>La poda post-floración es clave. Si se poda tarde, se eliminan los futuros botones florales y la planta no florecerá el siguiente año. Usar tijeras de poda limpias y afiladas. Desinfectar herramientas entre plantas.</descripcion>
    </owl:NamedIndividual>

    <!-- ============================================================ -->
    <!--  INDIVIDUOS - COMPATIBILIDAD CON OTRAS PLANTAS               -->
    <!-- ============================================================ -->

    <owl:NamedIndividual rdf:about="#CompatibilidadAzalea">
        <rdf:type rdf:resource="#Compatibilidad"/>
        <descripcion>Plantas compatibles comparten necesidades de suelo ácido, sombra parcial y humedad similar. Plantas incompatibles alteran el pH del suelo o compiten agresivamente por recursos.</descripcion>
    </owl:NamedIndividual>

    <!-- Plantas compatibles -->
    <owl:NamedIndividual rdf:about="#Camelia">
        <rdf:type rdf:resource="#Planta"/>
        <nombreComun>Camelia (Camellia japonica)</nombreComun>
        <descripcion>Compatibilidad ALTA. Mismas necesidades: suelo ácido, sombra parcial, riego regular. Combinación estética ideal por floración en distintas épocas.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Hortensia">
        <rdf:type rdf:resource="#Planta"/>
        <nombreComun>Hortensia (Hydrangea macrophylla)</nombreComun>
        <descripcion>Compatibilidad ALTA. Ambas prefieren suelo ácido, sombra parcial y riego abundante. Excelente combinación en jardines de sombra.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Rododendro">
        <rdf:type rdf:resource="#Planta"/>
        <nombreComun>Rododendro (Rhododendron spp.)</nombreComun>
        <descripcion>Compatibilidad MUY ALTA. Son del mismo género botánico. Necesidades prácticamente idénticas. Conviven perfectamente en el mismo espacio.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Helechos">
        <rdf:type rdf:resource="#Planta"/>
        <nombreComun>Helechos (Ferns)</nombreComun>
        <descripcion>Compatibilidad ALTA. Los helechos crecen bien en las mismas condiciones de sombra y humedad. Estética de jardín selvático muy atractiva.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Hostas">
        <rdf:type rdf:resource="#Planta"/>
        <nombreComun>Hostas (Hosta spp.)</nombreComun>
        <descripcion>Compatibilidad ALTA. Plantas de sombra que comparten necesidades similares. Las hostas cubren el suelo estéticamente alrededor de las azaleas.</descripcion>
    </owl:NamedIndividual>

    <!-- Plantas incompatibles -->
    <owl:NamedIndividual rdf:about="#Lavanda">
        <rdf:type rdf:resource="#Planta"/>
        <nombreComun>Lavanda (Lavandula spp.)</nombreComun>
        <descripcion>Compatibilidad BAJA. La lavanda prefiere suelo alcalino y sol pleno, opuesto a la azalea. Compiten por condiciones incompatibles.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Geranio">
        <rdf:type rdf:resource="#Planta"/>
        <nombreComun>Geranio (Pelargonium spp.)</nombreComun>
        <descripcion>Compatibilidad BAJA. Los geranios prefieren sol pleno y suelo bien drenado con pH neutro-alcalino. Necesidades opuestas a la azalea.</descripcion>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Nogal">
        <rdf:type rdf:resource="#Planta"/>
        <nombreComun>Nogal (Juglans spp.)</nombreComun>
        <descripcion>Compatibilidad NULA. El nogal produce juglona, una toxina alelopática que inhibe el crecimiento de muchas plantas incluyendo azaleas. No plantar cerca.</descripcion>
    </owl:NamedIndividual>

    <!-- ============================================================ -->
    <!--  INDIVIDUO PRINCIPAL - AZALEA                                 -->
    <!-- ============================================================ -->

    <owl:NamedIndividual rdf:about="#AzaleaRhododendron">
        <rdf:type rdf:resource="#Azalea"/>
        <nombreComun>Azalea (Rhododendron spp.)</nombreComun>
        <descripcion>Arbusto ornamental de la familia Ericaceae. Conocida por su espectacular floración en colores variados. Planta acidófila que requiere cuidados específicos.</descripcion>
        <requiereCuidado rdf:resource="#RiegoAzalea"/>
        <requiereCuidado rdf:resource="#IluminacionAzalea"/>
        <requiereCuidado rdf:resource="#TemperaturaAzalea"/>
        <requiereCuidado rdf:resource="#AbonoAzalea"/>
        <requiereCuidado rdf:resource="#PodaAzalea"/>
        <esCompatibleCon rdf:resource="#Camelia"/>
        <esCompatibleCon rdf:resource="#Hortensia"/>
        <esCompatibleCon rdf:resource="#Rododendro"/>
        <esCompatibleCon rdf:resource="#Helechos"/>
        <esCompatibleCon rdf:resource="#Hostas"/>
        <noEsCompatibleCon rdf:resource="#Lavanda"/>
        <noEsCompatibleCon rdf:resource="#Geranio"/>
        <noEsCompatibleCon rdf:resource="#Nogal"/>
    </owl:NamedIndividual>

</rdf:RDF>
